      },
      "school_name": {
        "type": "string",
        "description": "目标学校名称"
      },
      "exam_type": {
        "type": "string",
        "description": "考试类型（中考/高考）"
      }
    },
    "required": [
      "region",
      "school_name",
      "exam_type"
    ],
    "type": "object"
  },
  "formValue": {
    "query": "{{input.region}} {{input.school_name}} 2024年 {{input.exam_type}} 录取分数线",
    "instruction": "提取该校最近一年的具体录取分数线数据，仅返回分数线数值，如无明确数据则返回'未查询到相关数据'，不要多余内容。"
